{
  "compilerOptions": {
    /* Language */
    "target": "ES2023",
     "skipLibCheck": true,

    /* Module system (Node backend) */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Project structure */
    "rootDir": "./",
    "outDir": "dist",

    /* TypeScript rules */
    "strict": true,
    "skipLibCheck": true,

    /* Node compatibility */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["esnext"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
